{
  "name": "@atrium/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atrium/db": "workspace:*",
    "@atrium/demo-data": "workspace:*",
    "@atrium/exporters": "workspace:*",
    "@atrium/importers": "workspace:*",
    "@atrium/mcp": "workspace:*",
    "@atrium/packs-core": "workspace:*",
    "@atrium/schema": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.12.5",
    "openid-client": "^6.8.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
