# Copy to .env and fill in. Never commit the real .env.

# The address people use, pointing (DNS A/AAAA record) at this server.
ATRIUM_DOMAIN=atrium.example.com
ATRIUM_WORKSPACE_NAME=Acme Architecture

# A long random password for the database (only used inside Docker).
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Optional single sign-on with OpenID Connect. Redirect URI to register at your provider:
#   https://<ATRIUM_DOMAIN>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Microsoft Entra ID
OIDC_DEFAULT_ROLE=viewer
