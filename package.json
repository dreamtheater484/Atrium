{
  "name": "atrium",
  "private": true,
  "description": "Atrium: one shared, living map of your enterprise architecture.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@atrium/server --filter=@atrium/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @atrium/server migrate",
    "db:seed": "pnpm --filter @atrium/server seed",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "videos:capture": "pnpm --filter @atrium/videos capture",
    "videos:render": "pnpm --filter @atrium/videos render",
    "start": "node apps/server/dist/main.js",
    "docker:build": "docker build -t atrium:latest .",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
