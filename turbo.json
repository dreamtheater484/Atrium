{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": [],
      "env": [
        "DATABASE_URL",
        "ATRIUM_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@atrium/server#build": {
      "dependsOn": [
        "^build",
        "@atrium/web#build",
        "@atrium/cli#build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
